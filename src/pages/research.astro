---
import Base from '../layouts/Base.astro';
import PillarCard from '../components/PillarCard.astro';
import ReactionDiffusionCanvas from '../components/ReactionDiffusionCanvas.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Research" description="Research areas of the Hübner Lab: speciation, adaptation, and domestication genomics.">

  <!-- Hero intro with Gray-Scott reaction-diffusion background -->
  <!-- Explicit paper bg so the section is never transparent -->
  <section class="relative" style="background-color: var(--color-paper);">
    <!-- RD canvas — absolute fill, pointer-events off, softened with opacity -->
    <div class="absolute inset-0 pointer-events-none" style="opacity: 0.55;" aria-hidden="true">
      <ReactionDiffusionCanvas id="rd-research" preset="coral" height="100%" />
      <!-- Gradient mask: fades pattern to paper (hardcoded hex avoids CSS-var resolution issues) -->
      <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, transparent 0%, transparent 25%, var(--color-paper) 85%);"
      ></div>
    </div>

    <!-- Intro text — sits on top, relative so z stacking works -->
    <div class="container relative py-20">
      <div class="section-enter max-w-2xl mb-16">
        <p class="caption mb-4">Research</p>
        <h1 style="font-size: var(--text-h1);">
          The genomics of plant evolution
        </h1>
        <p class="mt-4 leading-relaxed" style="color: var(--color-soil);">
          We study how selection, drift, gene flow, and the environment shape
          genetic variation across plant populations and species. Our work spans
          wild and domesticated systems, combining population-scale whole-genome
          sequencing with landscape, ecological, and phenotypic data.
        </p>
      </div>
    </div>
  </section>

  <!-- Three research pillars + study systems — outside the RD section -->
  <div class="container pb-20">
    <div class="grid gap-8 md:grid-cols-3">
      <PillarCard
        title="Speciation"
        body="How do populations diverge into distinct species? We investigate the genomic architecture of reproductive isolation, admixture barriers, and the role of chromosomal rearrangements in speciation — with a focus on wild barley (Hordeum spontaneum) and sunflower."
        canvasId="canvas-speciation"
        img={`${base}botanical/phylogenetic_tree-removebg.png`}
        imgAlt="Circular phylogenetic tree"
        organisms={['Hordeum spontaneum', 'Helianthus annuus']}
      />
      <PillarCard
        title="Adaptation"
        body="How do plants track environmental heterogeneity? We identify signatures of local adaptation using landscape genomics, environmental association analysis, and GWAS, linking genetic variants to climate, soil, and phenology across large geographic gradients."
        canvasId="canvas-adaptation"
        img={`${base}botanical/adaptation_crop.png`}
        imgAlt="Plant adapting from cracked dry soil to lush green — environmental adaptation"
        imgBg="#F7F6F1"
        organisms={['Hordeum spontaneum', 'Triticum aestivum', 'Eragrostis tef']}
      />
      <PillarCard
        title="Domestication"
        body="What genomic changes accompanied the transition from wild to cultivated? We reconstruct domestication history, identify selective sweeps, and trace the origin and spread of crop lineages — in barley, wheat, grapevine, and tef."
        canvasId="canvas-domestication"
        img={`${base}botanical/domestication_crops.png`}
        imgAlt="Wheat ears illustration — domesticated crops"
        imgBg="#F7F6F1"
        organisms={['Hordeum vulgare', 'Triticum aestivum', 'Vitis vinifera', 'Eragrostis tef']}
      />
    </div>

    <!-- Organism grid -->
    <div class="section-enter mt-20">
      <p class="caption mb-6">Study systems</p>
      <div class="flex flex-wrap gap-3">
        {[
          'Wild barley (Hordeum spontaneum)',
          'Barley (Hordeum vulgare)',
          'Wild emmer wheat',
          'Bread wheat (Triticum aestivum)',
          'Sunflower (Helianthus annuus)',
          'Grapevine (Vitis vinifera)',
          'Tef (Eragrostis tef)',
        ].map((org) => (
          <span
            class="px-4 py-2 rounded-full text-sm border"
            style="border-color: color-mix(in srgb, var(--color-leaf) 30%, transparent); color: var(--color-leaf);"
          >
            <em>{org}</em>
          </span>
        ))}
      </div>
    </div>
  </div>
</Base>
