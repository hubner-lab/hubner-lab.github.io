---
// The home page: the hero, then one reading column with the mission and the "Latest" list, the
// newest of the news posts and the papers in one stream (src/lib/feed.ts).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LatestRow from '../components/LatestRow.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { loadLatest } from '../lib/sources';

const rows = await loadLatest(6);
---

<Base>
  <Hero />

  <div class="wrap">
    <div class="column">
      <section class="mission reveal">
        <h2>Understanding how plants adapt and diversify across landscapes</h2>
        <p>
          Our research integrates population genomics, landscape ecology, and quantitative genetics
          to understand the forces shaping genetic diversity in wild and domesticated plant species.
          We work across a range of crops and their wild relatives — including wild barley,
          sunflower, wheat, grapevine, and tef — using genome-wide data to illuminate the
          evolutionary histories and adaptive potential of these plants.
        </p>
      </section>

      {rows.length > 0 && (
        <section class="latest reveal" style="--i: 1" data-latest>
          <SectionHeader eyebrow="Latest" title="Papers and news" />
          <ul class="rows">
            {rows.map((item) => <LatestRow item={item} />)}
          </ul>
          <p class="all">
            <Button href="/news/" variant="ghost" size="sm">All news<Icon name="arrow-right" size={14} /></Button>
            <Button href="/publications/" variant="ghost" size="sm">All publications<Icon name="arrow-right" size={14} /></Button>
          </p>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  /* One column for reading, in the middle of the page. */
  .column {
    display: flex;
    flex-direction: column;
    gap: 30px;
    max-width: 43.75rem;
    margin-inline: auto;
    padding-top: var(--spacing-section);
  }

  .mission {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .mission p {
    max-width: 66ch;
    color: var(--color-muted);
  }

  .latest {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .rows {
    list-style: none;
  }
  .all {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
