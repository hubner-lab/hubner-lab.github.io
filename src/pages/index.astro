---
import Base from '../layouts/Base.astro';
import TixyCanvas from '../components/TixyCanvas.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Latest 3 news posts
const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Home">
  <!-- Hero -->
  <section class="relative">
    <TixyCanvas id="hero-tixy" height="clamp(520px, 72vh, 680px)" bgVideo={`${base}/botanical/wheat_hero.mp4`} />

    <!-- sr-only wordmark for SEO/a11y — visually the dot grid spells the name -->
    <h1 class="sr-only">Hübner Lab — Evolutionary and Landscape Genomics</h1>

    <!-- Top-left eyebrow caption -->
    <div class="absolute top-8 left-0 right-0 px-8 md:px-12 pointer-events-none">
      <p class="caption" style="color: var(--color-leaf);">Evolutionary &amp; Landscape Genomics</p>
    </div>

    <!-- Bottom-left: subtitle + CTAs — editorial asymmetric column -->
    <div class="absolute bottom-10 left-0 right-0 px-8 md:px-12">
      <div class="max-w-[520px]">
        <p class="text-lg leading-relaxed mb-5" style="color: var(--color-soil);">
          Decoding the genomic basis of plant adaptation, speciation,
          and domestication — from wild barley to sunflower.
        </p>
        <div class="flex gap-3 flex-wrap">
          <a
            href={`${base}/research`}
            class="cursor-pointer px-5 py-2.5 rounded-full font-medium text-sm no-underline shadow-sm hover:shadow-md transition-all duration-200 hover:opacity-90"
            style="background-color: var(--color-ink); color: var(--color-paper);"
          >
            Our Research
          </a>
          <a
            href={`${base}/publications`}
            class="cursor-pointer px-5 py-2.5 rounded-full font-medium text-sm no-underline border transition-colors duration-200 hover:bg-black/5"
            style="border-color: var(--color-soil); color: var(--color-soil);"
          >
            Publications
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="container section-enter mt-24">
    <div class="max-w-2xl">
      <p class="caption mb-4">Mission</p>
      <h2 class="mb-6" style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
        Understanding how plants adapt and diversify across landscapes
      </h2>
      <p class="leading-relaxed" style="color: var(--color-soil);">
        Our research integrates population genomics, landscape ecology, and quantitative genetics
        to understand the forces shaping genetic diversity in wild and domesticated plant species.
        We work across a range of crops and their wild relatives — including wild barley,
        sunflower, wheat, grapevine, and tef — using genome-wide data to illuminate the
        evolutionary histories and adaptive potential of these plants.
      </p>
    </div>
  </section>

  <!-- Latest news teaser -->
  {latestNews.length > 0 && (
    <section class="container mt-24">
      <div class="flex items-baseline justify-between mb-8">
        <p class="caption">Latest News</p>
        <a href={`${base}/news`} style="color: var(--color-data); font-size: 0.875rem;">All news →</a>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {latestNews.map((post) => (
          <NewsCard
            title={post.data.title}
            date={post.data.date}
            slug={post.id}
            summary={post.data.summary}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  )}

  <div class="h-24" aria-hidden="true"></div>
</Base>
