---
// The News page: all of the news, newest first. A row is a news post, or a paper with the day
// the Scholar bot first listed it (src/lib/feed.ts). The same list is /rss.xml.
import Base from '../../layouts/Base.astro';
import LatestRow from '../../components/LatestRow.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { loadFeed } from '../../lib/sources';

const items = await loadFeed();
---

<Base title="News" description="News from the Hübner Lab: announcements and new papers.">
  <div class="wrap">
    <SectionHeader as="h1" eyebrow="News" title="From the lab" class="head reveal">
      <Fragment slot="lead">
        Announcements and new papers. Also as an
        <a class="feed" href="/rss.xml"><Icon name="rss" size={14} />RSS feed</a>.
      </Fragment>
    </SectionHeader>

    <div class="body reveal" style="--i: 1">
      {items.length > 0 ? (
        <ul class="rows" data-news>
          {items.map((item) => <LatestRow item={item} when="day" />)}
        </ul>
      ) : (
        <p class="empty">No news yet.</p>
      )}
    </div>
  </div>
</Base>

<style>
  .head {
    padding-top: var(--spacing-section);
    padding-bottom: 12px;
  }
  .body {
    max-width: 51.25rem;   /* a line of a row stays short enough to read */
    padding-top: 36px;
  }
  .rows {
    list-style: none;
  }
  .empty {
    color: var(--color-muted);
  }

  .feed {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .feed:hover {
    text-decoration-thickness: 2px;
  }
  .feed :global(svg) {
    align-self: center;
  }

  @media (width < 40rem) {
    .head { padding-top: 28px; }
  }
</style>
