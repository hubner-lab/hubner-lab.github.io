---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const base = import.meta.env.BASE_URL;
---

<Base title={post.data.title} description={post.data.summary}>
  <div class="container py-20 relative">

    <div class="max-w-2xl mx-auto">
      <a
        href={`${base}/news`}
        class="caption no-underline hover:underline inline-block mb-8"
        style="color: var(--color-data);"
      >
        ← All news
      </a>

      <time class="caption block mb-4" datetime={post.data.date.toISOString()}>{dateStr}</time>

      <h1 class="mb-6" style="font-size: var(--text-h1);">{post.data.title}</h1>

      {post.data.tags && (
        <div class="flex flex-wrap gap-2 mb-8">
          {post.data.tags.map((tag: string) => (
            <span
              class="px-2.5 py-1 rounded-full text-xs"
              style="background-color: color-mix(in srgb, var(--color-wheat) 15%, transparent); color: var(--color-soil);"
            >
              {tag}
            </span>
          ))}
        </div>
      )}

      <div class="prose" style="color: var(--color-soil); max-width: none;">
        <Content />
      </div>
    </div>
  </div>
</Base>
