---
// A news post: one reading column with the way back to the list, the title, the day, the tags,
// and the text of the post, set by Prose.
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Prose from '../../components/ui/Prose.astro';
import Tag from '../../components/ui/Tag.astro';
import Icon from '../../components/ui/Icon.astro';
import { getCollection, render } from 'astro:content';
import { formatDay } from '../../lib/feed';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const day = post.data.date.toISOString().slice(0, 10);
const tags = post.data.tags ?? [];
---

<Base title={post.data.title} description={post.data.summary}>
  <article class="wrap">
    <div class="column">
      <a class="back reveal" href="/news/"><Icon name="arrow-left" size={14} />All news</a>

      <SectionHeader as="h1" eyebrow="News" title={post.data.title} class="reveal">
        <p class="facts">
          <time datetime={day}>{formatDay(day, 'long')}</time>
          {tags.map((tag) => <Tag tone="accent">{tag}</Tag>)}
        </p>
      </SectionHeader>

      <Prose class="reveal" style="--i: 1" data-post-body><Content /></Prose>
    </div>
  </article>
</Base>

<style>
  .column {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 43.75rem;
    margin-inline: auto;
    padding-top: var(--spacing-section);
  }

  .back {
    align-self: flex-start;   /* as wide as its words, not as the column */
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-small);
    color: var(--color-link);
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 16px;
  }
  .facts time {
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  @media (width < 40rem) {
    .column { padding-top: 28px; }
  }
</style>
