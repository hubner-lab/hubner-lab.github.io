---
// The site footer: who to contact, the pages, the institutes (and the funders once the config
// names any), then a base line with the copyright and the day the site was last built.
import { site } from '../site.config';

const strip = (p: string) => p.replace(/^\/+|\/+$/g, '');
const here = strip(Astro.url.pathname);
const current = (href: string) => {
  const target = strip(href);
  return here === target || here.startsWith(`${target}/`) ? 'page' : undefined;
};

// The day of the build, in the lab's time zone. en-CA writes a date as 2026-11-16.
const built = new Date();
const builtIso = built.toLocaleDateString('en-CA', { timeZone: site.timeZone });
const builtLabel = built.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: site.timeZone });
const institutes = site.affiliations.map((a) => a.short ?? a.name).join(' & ');
const organisations = [...site.affiliations, ...site.funders];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <h2>Contact</h2>
        <p>
          {site.pi.name}<br />
          {institutes}<br />
          {site.city}<br />
          <a class="email" href={`mailto:${site.pi.email}`}>{site.pi.email}</a>
        </p>
      </div>

      <nav aria-label="Footer">
        <h2>Explore</h2>
        <ul data-nav="footer">
          {site.nav.map(({ href, label }) => (
            <li><a href={href} aria-current={current(href)}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2>{site.funders.length > 0 ? 'Affiliations and funding' : 'Affiliations'}</h2>
        <ul>
          {organisations.map(({ name, url }) => (
            <li>{url ? <a href={url} target="_blank" rel="noopener noreferrer">{name}</a> : name}</li>
          ))}
        </ul>
      </div>
    </div>

    <p class="base">
      <span>© {builtIso.slice(0, 4)} {site.name}. All rights reserved.</span>
      <span>Updated <time datetime={builtIso}>{builtLabel}</time></span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--spacing-section);
    padding-block: 44px 22px;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-muted);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  h2 {
    margin-bottom: 10px;
    font: 500 0.75rem/1.6 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  ul {
    list-style: none;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a[aria-current] {
    color: var(--color-ink);
  }
  a.email {
    color: var(--color-link);
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 32px;
    font-size: 0.75rem;
  }

  @media (width < 40rem) {
    .site-footer { padding-block: 36px 20px; }
    .cols { grid-template-columns: minmax(0, 1fr); gap: 22px; }
  }
</style>
