---
import ThemeToggle from './ThemeToggle.astro';
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}/research`, label: 'Research' },
  { href: `${base}/team`,     label: 'Team' },
  { href: `${base}/publications`, label: 'Publications' },
  { href: `${base}/news`,    label: 'News' },
  { href: `${base}/contact`, label: 'Contact' },
];

const current = Astro.url.pathname;
---

<nav
  aria-label="Main navigation"
  class="fixed top-4 left-4 right-4 z-50 flex items-center justify-between gap-4
         rounded-full px-5 py-2.5
         backdrop-blur-md border"
  style="background-color: color-mix(in srgb, var(--color-paper) 85%, transparent); border-color: color-mix(in srgb, var(--color-ink) 12%, transparent);"
>
  <!-- Logo / home link -->
  <a
    href={base || '/'}
    class="font-display font-semibold text-base no-underline"
    style="color: var(--color-ink); font-family: var(--font-display); font-variation-settings: 'opsz' 36;"
    aria-label="Hübner Lab home"
  >
    Hübner Lab
  </a>

  <!-- Links + theme toggle -->
  <div class="flex items-center gap-1">
  <ul class="flex items-center gap-1 list-none m-0 p-0" role="list">
    {links.map(({ href, label }) => {
      const isActive = current.startsWith(href.replace(base, '') || '/') && href !== (base || '/');
      return (
        <li>
          <a
            href={href}
            class="px-3 py-1.5 rounded-full text-sm no-underline transition-colors duration-200"
            style={isActive
              ? 'background-color: var(--color-ink); color: var(--color-paper);'
              : 'color: var(--color-soil);'}
            aria-current={isActive ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      );
    })}
  </ul>
  <ThemeToggle />
  </div>
</nav>

<!-- Spacer so content isn't hidden under the fixed nav -->
<div class="h-16" aria-hidden="true"></div>
