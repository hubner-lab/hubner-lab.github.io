---
import ThemeToggle from './ThemeToggle.astro';
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}research`, label: 'Research' },
  { href: `${base}team`,     label: 'Team' },
  { href: `${base}publications`, label: 'Publications' },
  { href: `${base}news`,    label: 'News' },
  { href: `${base}contact`, label: 'Contact' },
];

const current = Astro.url.pathname;
---

<nav
  aria-label="Main navigation"
  class="fixed top-4 left-4 right-4 z-50 flex flex-nowrap items-center gap-x-2 md:gap-x-4
         rounded-3xl md:rounded-full px-5 py-2.5
         backdrop-blur-md border"
  style="background-color: color-mix(in srgb, var(--color-paper) 85%, transparent); border-color: color-mix(in srgb, var(--color-ink) 12%, transparent);"
>
  <!-- Logo / home link — pinned, never compressed -->
  <a
    href={base || '/'}
    class="flex-shrink-0 font-display font-semibold text-base no-underline whitespace-nowrap"
    style="color: var(--color-ink); font-family: var(--font-display); font-variation-settings: 'opsz' 36;"
    aria-label="Hübner Lab home"
  >
    Hübner Lab
  </a>

  <!-- Scrollable link strip — takes remaining width, scrolls horizontally on mobile -->
  <div class="flex-1 min-w-0 overflow-x-auto no-scrollbar md:flex md:justify-end">
    <ul class="flex flex-nowrap items-center gap-1 list-none m-0 p-0 w-max md:w-auto" role="list">
      {links.map(({ href, label }) => {
        const isActive = current.startsWith(href.replace(base, '') || '/') && href !== (base || '/');
        return (
          <li>
            <a
              href={href}
              class="flex-shrink-0 whitespace-nowrap px-3 py-1.5 rounded-full text-sm no-underline transition-colors duration-200"
              style={isActive
                ? 'background-color: var(--color-ink); color: var(--color-paper);'
                : 'color: var(--color-soil);'}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>

  <!-- Theme toggle — pinned at right edge, never scrolls -->
  <div class="flex-shrink-0">
    <ThemeToggle />
  </div>
</nav>

<!-- Spacer so content isn't hidden under the fixed nav.
     Single-line nav ≈ 44px tall + 16px top inset → 80px total on mobile. -->
<div class="h-20 md:h-16" aria-hidden="true"></div>
