---
interface Props {
  title: string;
  date: Date;
  slug: string;
  summary?: string;
  tags?: string[];
}

const { title, date, slug, summary, tags } = Astro.props;
const base = import.meta.env.BASE_URL;

const dateStr = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article
  class="section-enter group p-5 rounded-xl border transition-colors duration-200"
  style="border-color: color-mix(in srgb, var(--color-soil) 15%, transparent); background-color: var(--color-surface);"
>
  <time class="caption block mb-2" datetime={date.toISOString()}>{dateStr}</time>
  <h3 class="text-lg font-semibold mb-2" style="font-family: var(--font-display); color: var(--color-ink);">
    <a href={`${base}/news/${slug}`} class="no-underline hover:underline" style="color: var(--color-ink);">
      {title}
    </a>
  </h3>
  {summary && <p class="text-sm leading-relaxed mb-3" style="color: var(--color-soil);">{summary}</p>}
  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span
          class="px-2 py-0.5 rounded-full text-xs"
          style="background-color: color-mix(in srgb, var(--color-wheat) 15%, transparent); color: var(--color-soil);"
        >
          {tag}
        </span>
      ))}
    </div>
  )}
</article>
