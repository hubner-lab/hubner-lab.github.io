---
import type { PresetKey } from './reactionDiffusion.ts';

interface Props {
  id: string;
  preset?: PresetKey;
  height?: string;
  class?: string;
}

const {
  id,
  preset    = 'coral',
  height    = '100%',
  class: className = '',
} = Astro.props;
---

<div
  class={`relative w-full overflow-hidden ${className}`}
  style={`height: ${height};`}
>
  <canvas
    id={id}
    data-rd-preset={preset}
    class="absolute inset-0 w-full h-full"
    aria-hidden="true"
  ></canvas>
</div>

<script>
  import { startReactionDiffusion, PALETTE_LIGHT, PALETTE_DARK } from './reactionDiffusion.ts';
  import type { PresetKey } from './reactionDiffusion.ts';

  function currentPalette() {
    return document.documentElement.dataset.theme === 'dark' ? PALETTE_DARK : PALETTE_LIGHT;
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-rd-preset]').forEach((canvas) => {
    const instance = startReactionDiffusion({
      canvas,
      preset: (canvas.dataset.rdPreset ?? 'coral') as PresetKey,
      palette: currentPalette(),
    });

    window.addEventListener('themechange', () => {
      instance.setPalette(currentPalette());
    });
  });
</script>
