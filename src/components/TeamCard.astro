---
// A person of the lab as a portrait card: the photo (or two initials) on top, then the name, the
// role, the bio in full, the research interests as chips, the links and the years. A slot whose
// field is empty is left out. The principal investigator has the same card as everybody else.
//
// The members portal draws this card as a live preview (`preview`): there every slot is in the
// markup, hidden while it is empty, and src/members/main.ts fills the `data-f` hooks while the
// member types. What a slot shows is worked out by src/lib/team.ts for the page and the portal
// alike. For a former member the card shows the span of years and a "Now: ..." line; the Team
// page lists former members by name, so only the preview draws that.
// `data-person` marks a person for the tests (tests/team/roster.test.mjs).
import Avatar from './ui/Avatar.astro';
import Card from './ui/Card.astro';
import { LINKS, linkHref, linkName, yearsLabel } from '../lib/team';

interface Props {
  name: string;
  role: string;
  group?: string;
  alumni?: boolean;
  bio?: string;
  interests?: string[];
  email?: string;
  orcid?: string;
  scholar?: string;
  github?: string;
  linkedin?: string;
  website?: string;
  yearJoined?: number;
  yearLeft?: number;
  currentPosition?: string;
  photo?: ImageMetadata;
  /**
   * Portal preview: every slot is rendered (hidden while empty) so a script can fill the
   * `data-f` hooks. Pages never set this.
   */
  preview?: boolean;
}

const {
  name, role, alumni = false, bio, interests = [], yearJoined, yearLeft, currentPosition, photo, preview = false,
} = Astro.props;

const links = LINKS.map(([key, label]) => ({ key, label, href: linkHref(key, Astro.props[key]) }));
const linked = links.some((link) => link.href);
const now = alumni ? currentPosition?.trim() : undefined;
const years = yearsLabel({ alumni, yearJoined, yearLeft });
---

<Card as="article" class="person" data-person>
  <Avatar name={name} photo={photo} data-f="photo" />

  <div class="body">
    <h3 class="name" data-f="name">{name}</h3>
    <p class="role" data-f="role">{role}</p>
    {(bio || preview) && <p class="bio" data-f="bio" hidden={!bio}>{bio}</p>}
    {(interests.length > 0 || preview) && (
      <ul class="chips" data-f="interests" aria-label="Research interests" hidden={interests.length === 0}>
        {interests.map((interest) => <li>{interest}</li>)}
      </ul>
    )}
    {(now || preview) && <p class="now" data-f="now" hidden={!now}>{now && `Now: ${now}`}</p>}
    {(linked || preview) && (
      <p class="links" data-f="links" hidden={!linked}>
        {links.map(({ key, label, href }) => (href || preview) && (
          <a
            data-f={key}
            href={href}
            hidden={!href}
            aria-label={linkName(key, label, name)}
            target={key === 'email' ? undefined : '_blank'}
            rel={key === 'email' ? undefined : 'noopener noreferrer'}
          >{label}</a>
        ))}
      </p>
    )}
    {(years || preview) && <p class="years" data-f="years" hidden={!years}>{years}</p>}
  </div>
</Card>

<style>
  .person {
    display: flex;
    flex-direction: column;
    height: 100%;   /* the cards of a row are equally tall */
    overflow: hidden;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
    padding: 16px 18px 18px;
    overflow-wrap: break-word;
  }

  .name {
    font-size: var(--text-h3);
  }
  .role {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .bio {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* The interests: the chips of ui/Tag.astro, written here for a list item, because the portal's
     preview makes its items with a script and those carry no scope of this file. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }
  .chips > :global(li) {
    padding: 3px 11px;
    font-size: 0.75rem;
    line-height: 1.5;
    border-radius: var(--radius-chip);
    background: var(--color-leaf-tint);
    color: var(--color-on-leaf-tint);
  }

  .now {
    font-size: var(--text-meta);
    font-style: italic;
    color: var(--color-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: var(--text-meta);
  }
  .links a {
    padding-block: 2px;   /* a little more to press */
    color: var(--color-link);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-link) 40%, transparent);
  }
  .links a:hover {
    border-bottom-color: currentColor;
  }

  .years {
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
</style>
