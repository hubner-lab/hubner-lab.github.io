---
// Theme toggle: a sun in the dark theme (press for light), a moon in the light one.
// The theme is the `data-theme` attribute of <html>. The head script in Base.astro applies a
// stored choice before the first paint; this button is the only thing that stores one (key
// `hl-theme`), and only when it is pressed. `themechange` tells the canvases that take their
// colours in script to take them again.
// The button is found by attribute, not by id, so a page may carry more than one. Without
// JavaScript it would do nothing, so it is not shown (`data-js-only`).
import Icon from './ui/Icon.astro';
---

<button type="button" class="toggle" data-theme-toggle data-js-only aria-label="Dark theme" aria-pressed="true">
  <Icon name="sun" size={16} class="sun" />
  <Icon name="moon" size={16} class="moon" />
</button>

<style>
  .toggle {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    cursor: pointer;
  }
  .toggle::before {   /* a 44px target around the 32px circle */
    content: "";
    position: absolute;
    inset: -6px;
  }
  .toggle:hover {
    border-color: var(--color-muted);
  }
  .moon { display: none; }
  :global(:root[data-theme="light"]) .sun { display: none; }
  :global(:root[data-theme="light"]) .moon { display: block; }
</style>

<script>
  const KEY = 'hl-theme';
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const isDark = () => root.dataset.theme !== 'light';
  const sync = () => toggles.forEach((b) => b.setAttribute('aria-pressed', String(isDark())));

  sync();
  toggles.forEach((b) =>
    b.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {
        // Storage is closed (private mode): the choice lasts for this page.
      }
      // The browser's own bars follow: the two colours are on the meta tag (Base.astro).
      const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      if (meta?.dataset[next]) meta.content = meta.dataset[next];
      sync();
      window.dispatchEvent(new Event('themechange'));
    }),
  );
</script>
