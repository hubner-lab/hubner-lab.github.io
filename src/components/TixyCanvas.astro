---
interface Props {
  id: string;
  cols?: number;
  rows?: number;
  wordSpeed?: number;
  ambientSpeed?: number;
  height?: string;
  bgImage?: string;
  bgVideo?: string;
  class?: string;
}

const {
  id,
  cols         = 140,
  rows         = 40,
  wordSpeed    = 0.0225,
  ambientSpeed = 0.002,
  height       = '520px',
  bgImage      = '',
  bgVideo      = '',
  class: className = '',
} = Astro.props;

// Derive WebM path from MP4 path (same name, different ext) for <source> fallback
const bgVideoWebm   = bgVideo ? bgVideo.replace(/\.mp4$/, '.webm')        : '';
// Poster still — shown while video buffers and when autoplay is blocked (Low Power Mode, etc.)
const bgVideoPoster = bgVideo ? bgVideo.replace(/\.mp4$/, '_poster.jpg') : '';
---

<div class={`relative w-full overflow-hidden rounded-lg ${className}`} style={`height: ${height};`}>
  {bgVideo ? (
    <>
      <!-- Looping video backdrop — autoplay muted so browsers allow it.
           poster= shows a still frame immediately while the video buffers.
           webkit-playsinline covers legacy in-app webviews.
           The <img> below is hidden by default; JS swaps it in when autoplay
           is blocked (iOS Low Power Mode, Data Saver, user pref). -->
      <video
        id={`${id}-bg-video`}
        data-poster-img={`${id}-bg-poster`}
        class="absolute inset-0 w-full h-full object-cover"
        autoplay muted loop playsinline webkit-playsinline
        poster={bgVideoPoster}
        preload="metadata"
        aria-hidden="true"
      >
        {bgVideoWebm && <source src={bgVideoWebm} type="video/webm" />}
        <source src={bgVideo} type="video/mp4" />
      </video>
      <!-- Autoplay-blocked fallback — hidden by default, revealed by JS -->
      <img
        id={`${id}-bg-poster`}
        src={bgVideoPoster}
        alt=""
        aria-hidden="true"
        hidden
        class="absolute inset-0 w-full h-full object-cover"
      />
      <!-- Soft dark scrim: halo behind wordmark band + top/bottom fades -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background:
          radial-gradient(ellipse 62% 40% at 50% 38%, rgba(11,15,20,0.42) 0%, rgba(11,15,20,0) 72%),
          linear-gradient(180deg, rgba(11,15,20,0.30) 0%, rgba(11,15,20,0) 26%, rgba(11,15,20,0) 60%, rgba(11,15,20,0.38) 100%);"
        aria-hidden="true"
      ></div>
    </>
  ) : bgImage ? (
    <>
      <!-- Static photo backdrop -->
      <div
        class="absolute inset-0"
        style={`background-image: url(${bgImage}); background-size: cover; background-position: center 60%;`}
        aria-hidden="true"
      ></div>
      <!-- Soft dark scrim -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background:
          radial-gradient(ellipse 62% 40% at 50% 38%, rgba(11,15,20,0.42) 0%, rgba(11,15,20,0) 72%),
          linear-gradient(180deg, rgba(11,15,20,0.30) 0%, rgba(11,15,20,0) 26%, rgba(11,15,20,0) 60%, rgba(11,15,20,0.38) 100%);"
        aria-hidden="true"
      ></div>
    </>
  ) : null}
  <canvas
    id={id}
    data-tixy-text="Hübner Lab"
    data-tixy-cols={cols}
    data-tixy-rows={rows}
    data-tixy-word-speed={wordSpeed}
    data-tixy-ambient-speed={ambientSpeed}
    class="absolute inset-0 w-full h-full"
    aria-hidden="true"
  ></canvas>
</div>

<script>
  import { startTixyCanvas } from './tixyCanvas.ts';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-tixy-text]').forEach((canvas) => {
    startTixyCanvas({
      canvas,
      cols:         parseInt(canvas.dataset.tixyCols         ?? '140',    10),
      rows:         parseInt(canvas.dataset.tixyRows         ?? '40',     10),
      wordSpeed:    parseFloat(canvas.dataset.tixyWordSpeed    ?? '0.012'),
      ambientSpeed: parseFloat(canvas.dataset.tixyAmbientSpeed ?? '0.002'),
    });
  });

  // Kill the native play button when autoplay is blocked (iOS Low Power Mode,
  // Data Saver, browser policy). video.play() returns a Promise that rejects
  // with NotAllowedError in that case — swap to the still <img> fallback.
  document.querySelectorAll<HTMLVideoElement>('video[data-poster-img]').forEach((video) => {
    const imgId = video.dataset.posterImg;
    const img = imgId ? (document.getElementById(imgId) as HTMLImageElement | null) : null;
    if (!img) return;
    const p = video.play();
    if (p !== undefined) {
      p.catch(() => {
        video.hidden = true;
        img.hidden = false;
      });
    }
  });
</script>
