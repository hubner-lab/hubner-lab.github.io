---
// The lab's name in dots: a canvas drawn by ./tixyCanvas.ts. It moves, unless the visitor asked
// for reduced motion; then it is one still frame. Decorative: hidden from assistive technology.
// Without JavaScript the canvas stays empty, so the caller marks its place `data-js-only`.
//   layout="strip"  one line; the canvas takes the size of the line, inside its parent
//   layout="hero"   the two words large, in a canvas that fills its positioned parent
// What stands behind the dots (a video, a picture) is the caller's business.
interface Props {
  text?: string;
  layout?: 'hero' | 'strip';
  /** The size of one dot cell in px. */
  cell?: number;
  /** strip: its height in cells. hero: the most rows of the grid. */
  rows?: number;
  /** hero: the most columns of the grid. */
  cols?: number;
  /** How fast the ripple runs. */
  wordSpeed?: number;
  class?: string;
  /** Astro adds the scope attribute of the parent's <style> here. */
  [key: `data-${string}`]: unknown;
}

const { text = 'Hübner Lab', layout = 'hero', cell, rows, cols, wordSpeed = 0.0225, class: className, ...rest } = Astro.props;
---

<canvas
  {...rest}
  class:list={['tixy', layout === 'hero' && 'tixy--fill', className]}
  data-tixy-text={text}
  data-tixy-layout={layout}
  data-tixy-cell={cell}
  data-tixy-rows={rows}
  data-tixy-cols={cols}
  data-tixy-word-speed={wordSpeed}
  aria-hidden="true"
></canvas>

<style>
  .tixy {
    display: block;
    max-width: 100%;
  }
  .tixy--fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { startTixyCanvas } from './tixyCanvas';

  const number = (value?: string) => (value ? Number(value) : undefined);

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-tixy-text]').forEach((canvas) => {
    const d = canvas.dataset;
    startTixyCanvas({
      canvas,
      text: d.tixyText,
      layout: d.tixyLayout === 'strip' ? 'strip' : 'hero',
      cell: number(d.tixyCell),
      rows: number(d.tixyRows),
      cols: number(d.tixyCols),
      wordSpeed: number(d.tixyWordSpeed),
    });
  });
</script>
