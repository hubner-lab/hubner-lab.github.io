---
// The body of a text that was written as Markdown, such as a news post: how its paragraphs,
// headings, lists, links, quotes, code, rules, pictures and tables are set.
// The rendered Markdown carries no scope of this file, so the rules reach it through :global().
// A link needs no rule here: a link without a class is a text link everywhere (global.css).
// A code block brings its own colours, the same dark ones in both themes (Astro's highlighter
// writes them on the element); this file gives it the box.
// Any other attribute goes to the element. Astro also passes the scope of the caller's <style>,
// so the caller can place the text through the class it gives.
import type { HTMLAttributes } from 'astro/types';

type Props = { class?: string } & Omit<HTMLAttributes<'div'>, 'class'>;

const { class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={['prose', className]}><slot /></div>

<style>
  .prose {
    /* As wide as its place allows and never wider, whatever it holds: a long line of code or a
       wide table scrolls inside its own box instead of widening the page. */
    width: 100%;
    min-width: 0;
    max-width: 66ch;
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--color-ink);
    overflow-wrap: break-word;
  }
  .prose > :global(* + *) {
    margin-top: 1.1em;
  }

  .prose :global(:is(h2, h3, h4)) {
    line-height: 1.25;
  }
  .prose > :global(:is(h2, h3, h4)) {
    margin-top: 1.8em;
  }
  .prose > :global(:is(h2, h3, h4) + *) {
    margin-top: 0.6em;
  }
  .prose :global(h2) { font-size: 1.625rem; }
  .prose :global(h3) { font-size: 1.3125rem; }
  .prose :global(h4) {
    font: 600 1rem/1.4 var(--font-body);
    letter-spacing: 0;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.4em;
  }
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li + li),
  .prose :global(li > :is(ul, ol)) {
    margin-top: 0.35em;
  }
  .prose :global(li::marker) {
    color: var(--color-muted);
  }

  .prose :global(blockquote) {
    padding-left: 1.1em;
    font-style: italic;
    color: var(--color-muted);
    border-left: 2px solid var(--color-accent);
  }
  .prose :global(blockquote > * + *) {
    margin-top: 0.8em;
  }

  .prose :global(code) {
    padding: 0.1em 0.35em;
    font: 0.875em var(--font-mono);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-ink) 9%, transparent);
  }
  .prose :global(pre) {
    padding: 14px 16px;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.55;
    border: 1px solid var(--color-line);
    border-radius: 12px;
  }
  .prose :global(pre code) {
    padding: 0;
    font-size: inherit;
    border-radius: 0;
    background: none;
  }

  .prose :global(hr) {
    margin-block: 2em;
    border: 0;
    border-top: 1px solid var(--color-line);
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  /* A table scrolls sideways inside the text column when it is wider than the column. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    font-size: var(--text-small);
    border-collapse: collapse;
  }
  .prose :global(:is(th, td)) {
    padding: 8px 14px 8px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  .prose :global(th) {
    font-weight: 600;
    border-bottom-color: var(--color-muted);
  }
</style>
