---
interface Props {
  title: string;
  authors: string;
  venue: string;
  year: number;
  url?: string;
  citations?: number;
}

const { title, authors, venue, year, url, citations } = Astro.props;

// Bold "Hübner, S" / "Hubner, S" in author string
const boldedAuthors = authors
  .replace(/(H[uü]bner,?\s*S\.?)/gi, '<strong>$1</strong>');
---

<article class="py-4 border-b" style="border-color: color-mix(in srgb, var(--color-soil) 15%, transparent);">
  <p class="font-medium leading-snug mb-1" style="color: var(--color-ink);">
    {url
      ? <a href={url} target="_blank" rel="noopener noreferrer" style="color: var(--color-ink); text-decoration: none;" class="hover:underline">{title}</a>
      : title
    }
  </p>
  <p
    class="text-sm mb-0.5"
    style="color: var(--color-soil);"
    set:html={boldedAuthors}
  />
  <p class="text-sm" style="color: color-mix(in srgb, var(--color-soil) 70%, transparent);">
    <em>{venue}</em>
    {citations ? <span class="ml-2 font-mono text-xs" style="color: var(--color-wheat);">↑{citations}</span> : null}
  </p>
</article>
